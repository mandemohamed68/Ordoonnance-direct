# --- API Gemini (Google AI Studio) ---
GEMINI_API_KEY=votre_cle_gemini_ici

# --- Configuration Firebase (Client-side) ---
# Ces variables sont utilisées par Vite pour l'initialisation de Firebase dans le navigateur.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Configuration SMS (Aqila SMS) ---
SMS_API_USER=votre_nom_utilisateur_aqila
SMS_API_HASH=votre_cle_hash_aqila
SMS_SENDER_ID=SanteDirect

# --- Configuration Paiement (Sappay) ---
SAPPAY_CLIENT_ID=votre_client_id
SAPPAY_CLIENT_SECRET=votre_client_secret
SAPPAY_USERNAME=votre_username_sappay
SAPPAY_PASSWORD=votre_password_sappay

# --- Configuration Serveur ---
PORT=3000
NODE_ENV=production
VITE_API_BASE_URL=http://localhost:3000
